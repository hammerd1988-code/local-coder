{
  "name": "mimo-magic-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --project tsconfig.server.json",
    "start": "tsx watch scripts/dev.ts",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-local-coder.ps1",
    "app:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "lint": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "test": "echo \"No tests configured yet\" && exit 0",
    "test:coverage": "echo \"No coverage configured yet\" && exit 0",
    "docker:build": "docker build -t local-coder .",
    "docker:build:dev": "docker build -t local-coder:dev -f Dockerfile.dev .",
    "docker:run": "docker-compose up -d",
    "docker:run:dev": "docker-compose --profile dev up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy": "bash scripts/deploy.sh",
    "rollback": "bash scripts/rollback.sh",
    "health-check": "bash scripts/health-check.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/hub": "^2.13.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-tooltip": "1.2.16",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "16.4.7",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "kysely": "^0.29.4",
    "lucide-react": "0.474.0",
    "node-pty": "^1.1.0",
    "prom-client": "^15.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.3.1",
    "react-resizable-panels": "^2.1.8",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1",
    "simple-git": "^3.36.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "3.2.0",
    "tailwindcss-animate": "1.0.7",
    "ws": "^8.21.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.13.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "ignore": "7.0.6",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "typescript": "5.8.2",
    "vite": "8.2.0"
  }
}
